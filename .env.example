# Só os NOMES das variáveis. Valores reais ficam no Easypanel (produção) e nunca no repositório.
# Quem lê cada uma e onde ela vale: docs/operacao/deploy.md, seção 3.

# --- app e worker ---
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
CABECALHO_IP_CLIENTE=
RETENCAO_TEXTO_BRUTO_DIAS=
LOG_LEVEL=
SENTRY_DSN=

# --- só o app ---
PORT=

# --- só o worker ---
ANTHROPIC_API_KEY=
RESEND_API_KEY=
EMAIL_REMETENTE=
EMAIL_AVISO_DECISAO=

# --- só a migration (passo separado, nunca no serviço do app nem do worker) ---
DATABASE_URL_MIGRATOR=

# --- só homologação e desenvolvimento (NUNCA em produção) ---
SEED_FICTICIO=

# --- definidas pela imagem ou pelo Next, não configurar ---
# NODE_ENV=
# NEXT_RUNTIME=

# --- só para o e2e (Playwright), fora do app ---
